# Copia este archivo a .env y completa los valores:  cp .env.example .env
# Solo main.go carga .env; en producción puedes usar variables del sistema (systemd, Docker).

# ── Servidor ────────────────────────────────────────────────────────────────
# Puerto HTTP (por defecto 8080)
PORT=8080

# Origen permitido para CORS. En producción: https://tudominio.com
# Si queda vacío se permite cualquier origen (*) — NO recomendado en producción.
ALLOWED_ORIGIN=http://localhost:8080

# Versión de assets para cache-busting (?v=...). Vacío = timestamp de arranque.
# Recomendado en deploy: STATIC_VERSION=$(git rev-parse --short HEAD)
STATIC_VERSION=

# 1 = enviar la CSP en modo "report-only" (no bloquea, solo avisa en consola).
# Útil para probar cambios de CSP en producción; luego vuélvelo a vaciar.
CSP_REPORT_ONLY=

# ── Sesiones (obligatorias) ─────────────────────────────────────────────────
# openssl rand -base64 64
SESSION_AUTH_KEY=
# openssl rand -base64 32
SESSION_ENC_KEY=

# ── Base de datos MySQL (obligatorias) ──────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORTDATABASE=3306
MYSQL_DATABASE=blog
MYSQL_USER=
MYSQL_ROOT_PASSWORD=
