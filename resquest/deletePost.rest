# Requiere sesión + CSRF: copia las cookies "session-name" y "csrf_token"
# desde el navegador (DevTools → Application → Cookies) tras entrar al dashboard.
@session = PEGA_AQUI_LA_COOKIE_session-name
@csrf = PEGA_AQUI_LA_COOKIE_csrf_token

DELETE http://localhost:8080/api/posts/1 HTTP/1.1
Cookie: session-name={{session}}; csrf_token={{csrf}}
X-CSRF-Token: {{csrf}}
